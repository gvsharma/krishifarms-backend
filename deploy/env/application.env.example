# Runtime config for KrishiFarms CRM on EC2.
# Copy to /opt/krishifarms/config/application.env on EC2.
# File mode: 640, owner root:krishifarms
#
# Deploy script merges this into /opt/krishifarms/repo/.env before docker compose up.

APP_NAME=KrishiFarms CRM
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# Option A — Local PostgreSQL in Docker Compose (current default / easy rollback):
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql+psycopg2://krishi:replace-with-strong-password@postgres:5432/krishifarms
#
# Option B — Supabase project ucvwtoziiqgmcyzxkwxe:
#   Dashboard: https://supabase.com/dashboard/project/ucvwtoziiqgmcyzxkwxe
#   Store full URL in SSM (preferred): bash deploy/scripts/put-supabase-database-url-ssm.sh
#   Or set below (never commit real password); always ?sslmode=require; URL-encode special chars:
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.ucvwtoziiqgmcyzxkwxe.supabase.co:5432/postgres?sslmode=require
#
# After cutover, optionally: docker compose -f infra/docker-compose.prod.yml stop postgres
# See docs/deploy/SUPABASE_MIGRATION.md

CACHE_PROVIDER=memory
CACHE_TTL_SECONDS=300
REDIS_URL=

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=krishifarms-documents
S3_PRESIGNED_URL_EXPIRE_SECONDS=900

# Vercel frontend + local dev
CORS_ORIGINS=https://krishifarms.vercel.app,http://localhost:3000

# Firebase Phone Auth — store service account via SSM; set JSON or mount credentials file
FIREBASE_PROJECT_ID=krishifarms-prod
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_LOGIN_RATE_LIMIT_PER_MINUTE=10

DEFAULT_ORG_NAME=Krishi Farms
DEFAULT_OWNER_EMAIL=owner@krishifarms.local
DEFAULT_OWNER_PASSWORD=ChangeMe123!
DEFAULT_OWNER_NAME=Owner
