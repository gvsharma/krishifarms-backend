-  description = "Whether daily EC2+RDS stop/start schedules are active."
+  description = "Whether daily EC2 stop/start schedules are active (RDS only when enable_rds is true)."
   value       = var.enable_cost_schedule
 }
 
diff --git a/environments/prod/variables.tf b/environments/prod/variables.tf
index ad27190..2d32b69 100644
--- a/environments/prod/variables.tf
+++ b/environments/prod/variables.tf
@@ -112,9 +112,15 @@ variable "db_username" {
   default = "gamya_admin"
 }
 
+variable "enable_rds" {
+  type        = bool
+  description = "Provision managed RDS PostgreSQL. Set false to omit RDS and use EC2-only cost scheduler."
+  default     = false
+}
+
 variable "enable_cost_schedule" {
   type        = bool
-  description = "Enable EC2+RDS stop/start schedules (Mon–Fri 06:00–11:00; Sat 18:00–00:00; Sun 06:00–00:00 IST by default)."
+  description = "Enable EC2 stop/start schedules. RDS included only when enable_rds is true."
   default     = true
 }
 
diff --git a/scripts/destroy-rds-instance.sh b/scripts/destroy-rds-instance.sh
new file mode 100755
index 0000000..6097e07
--- /dev/null
+++ b/scripts/destroy-rds-instance.sh
@@ -0,0 +1,60 @@
+#!/usr/bin/env bash
+# One-off: delete Gamya dev RDS if Terraform state is out of sync.
+#
+# Preferred: set enable_rds = false in environments/dev/ci.tfvars and merge to main
+# so GitHub Actions terraform apply destroys module.rds[0] resources.
+#
+# Usage:
+#   bash scripts/destroy-rds-instance.sh
+#   bash scripts/destroy-rds-instance.sh --dry-run
+#
+# Instance: gamya-couture-dev-pg (ap-south-1)
+set -euo pipefail
+
+REGION="${AWS_REGION:-ap-south-1}"
+DB_ID="${DB_INSTANCE_IDENTIFIER:-gamya-couture-dev-pg}"
+DRY_RUN=false
+
+if [[ "${1:-}" == "--dry-run" ]]; then
+  DRY_RUN=true
+fi
+
+log() { echo "[$(date -Iseconds)] $*"; }
+
+state() {
+  aws rds describe-db-instances \
+    --region "$REGION" \
+    --db-instance-identifier "$DB_ID" \
+    --query 'DBInstances[0].DBInstanceStatus' \
+    --output text 2>/dev/null || echo "missing"
+}
+
+STATUS="$(state)"
+if [[ "$STATUS" == "missing" || "$STATUS" == "None" ]]; then
+  log "RDS ${DB_ID} not found in ${REGION} — nothing to delete."
+  exit 0
+fi
+
+log "RDS ${DB_ID} status=${STATUS}"
+
+if [[ "$DRY_RUN" == true ]]; then
+  log "DRY-RUN would delete-db-instance ${DB_ID} (skip final snapshot)"
+  exit 0
+fi
+
+if [[ "$STATUS" == "stopped" ]]; then
+  log "Starting stopped instance before delete..."
+  aws rds start-db-instance --region "$REGION" --db-instance-identifier "$DB_ID" >/dev/null
+  aws rds wait db-instance-available --region "$REGION" --db-instance-identifier "$DB_ID"
+fi
+
+log "Deleting ${DB_ID} (skip final snapshot)..."
+aws rds delete-db-instance \
+  --region "$REGION" \
+  --db-instance-identifier "$DB_ID" \
+  --skip-final-snapshot \
+  --delete-automated-backups
+
+log "Waiting for deletion..."
+aws rds wait db-instance-deleted --region "$REGION" --db-instance-identifier "$DB_ID" || true
+log "Done."
