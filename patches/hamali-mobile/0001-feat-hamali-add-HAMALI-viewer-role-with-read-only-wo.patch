+package com.krishifarms.mobile.feature.hamali.data.remote
+
+import com.krishifarms.mobile.core.network.ApiResponse
+import com.krishifarms.mobile.feature.hamali.data.remote.dto.HamaliDailyDto
+import com.krishifarms.mobile.feature.hamali.data.remote.dto.HamaliSummaryPeriodDto
+import com.krishifarms.mobile.feature.hamali.data.remote.dto.HamaliWorkEntryListData
+import retrofit2.http.GET
+import retrofit2.http.Query
+
+interface HamaliApi {
+    @GET("hamali/me/daily")
+    suspend fun getMyDaily(
+        @Query("work_date") workDate: String? = null,
+    ): ApiResponse<HamaliDailyDto>
+
+    @GET("hamali/me/summary")
+    suspend fun getMySummary(
+        @Query("period") period: String,
+        @Query("anchor_date") anchorDate: String? = null,
+    ): ApiResponse<HamaliSummaryPeriodDto>
+
+    @GET("hamali/work-entries")
+    suspend fun listWorkEntries(
+        @Query("page") page: Int = 1,
+        @Query("page_size") pageSize: Int = 50,
+        @Query("work_date") workDate: String? = null,
+        @Query("date_from") dateFrom: String? = null,
+        @Query("date_to") dateTo: String? = null,
+    ): ApiResponse<HamaliWorkEntryListData>
+}
