+)
+
+private fun HamaliTipByFarmerDto.toDomain() = HamaliFarmerSummary(
+    farmerId = farmerId,
+    farmerName = farmerName,
+    bagCount = bagCount,
+    tipAmount = tipAmount,
+)
+
+private fun HamaliWorkEntryDto.toDomain() = HamaliWorkEntry(
+    id = id,
+    workDate = workDate,
+    farmerName = farmerName.orEmpty(),
+    bagCount = bagCount,
+    tipAmount = tipAmount,
+    notes = notes,
+)
