+package com.krishifarms.mobile.feature.hamali.presentation.home
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.krishifarms.mobile.feature.hamali.domain.model.HamaliDailySummary
+import com.krishifarms.mobile.feature.hamali.domain.model.HamaliPeriodSummary
+import com.krishifarms.mobile.feature.hamali.domain.repository.HamaliRepository
+import dagger.hilt.android.lifecycle.HiltViewModel
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import java.time.LocalDate
+import java.time.format.DateTimeFormatter
+import javax.inject.Inject
+
+enum class HamaliHomeTab {
+    DAILY,
+    WEEK,
+    MONTH,
+}
+
+data class HamaliHomeUiState(
+    val selectedTab: HamaliHomeTab = HamaliHomeTab.DAILY,
+    val workDate: String = LocalDate.now().toString(),
+    val anchorDate: String = LocalDate.now().toString(),
+    val isLoading: Boolean = true,
+    val isRefreshing: Boolean = false,
+    val daily: HamaliDailySummary? = null,
+    val weekSummary: HamaliPeriodSummary? = null,
+    val monthSummary: HamaliPeriodSummary? = null,
+    val errorMessage: String? = null,
+)
+
+@HiltViewModel
+class HamaliHomeViewModel @Inject constructor(
+    private val repository: HamaliRepository,
+) : ViewModel() {
+
+    private val _uiState = MutableStateFlow(HamaliHomeUiState())
+    val uiState: StateFlow<HamaliHomeUiState> = _uiState.asStateFlow()
+
+    private val displayDateFormatter = DateTimeFormatter.ofPattern("d MMM yyyy")
+
+    init {
+        refresh()
+    }
+
+    fun onTabSelected(tab: HamaliHomeTab) {
+        _uiState.update { it.copy(selectedTab = tab) }
+        refresh()
+    }
+
+    fun onPreviousDay() {
+        adjustWorkDate(days = -1)
+    }
+
+    fun onNextDay() {
+        adjustWorkDate(days = 1)
+    }
+
+    fun onPreviousPeriod() {
+        adjustAnchorDate(
+            when (_uiState.value.selectedTab) {
+                HamaliHomeTab.WEEK -> -7
+                HamaliHomeTab.MONTH -> -1
+                HamaliHomeTab.DAILY -> 0
+            },
+        )
+    }
+
+    fun onNextPeriod() {
+        adjustAnchorDate(
+            when (_uiState.value.selectedTab) {
+                HamaliHomeTab.WEEK -> 7
+                HamaliHomeTab.MONTH -> 1
+                HamaliHomeTab.DAILY -> 0
+            },
+        )
+    }
+
+    fun refresh() {
+        viewModelScope.launch {
+            val state = _uiState.value
+            val refreshing = state.daily != null || state.weekSummary != null || state.monthSummary != null
+            _uiState.update {
+                it.copy(
+                    isLoading = !refreshing,
+                    isRefreshing = refreshing,
+                    errorMessage = null,
+                )
+            }
+            when (state.selectedTab) {
+                HamaliHomeTab.DAILY -> loadDaily(state.workDate)
+                HamaliHomeTab.WEEK -> loadSummary("week", state.anchorDate, isWeek = true)
+                HamaliHomeTab.MONTH -> loadSummary("month", state.anchorDate, isWeek = false)
+            }
+        }
+    }
+
+    fun formatWorkDateLabel(): String =
+        runCatching { LocalDate.parse(_uiState.value.workDate).format(displayDateFormatter) }
+            .getOrDefault(_uiState.value.workDate)
+
+    fun periodLabel(): String {
+        val summary = when (_uiState.value.selectedTab) {
+            HamaliHomeTab.WEEK -> _uiState.value.weekSummary
+            HamaliHomeTab.MONTH -> _uiState.value.monthSummary
+            HamaliHomeTab.DAILY -> null
+        } ?: return ""
+        val from = runCatching { LocalDate.parse(summary.dateFrom).format(displayDateFormatter) }
+            .getOrDefault(summary.dateFrom)
+        val to = runCatching { LocalDate.parse(summary.dateTo).format(displayDateFormatter) }
+            .getOrDefault(summary.dateTo)
+        return "$from – $to"
+    }
+
+    private fun adjustWorkDate(days: Long) {
+        val next = runCatching {
+            LocalDate.parse(_uiState.value.workDate).plusDays(days).toString()
+        }.getOrNull() ?: return
+        _uiState.update { it.copy(workDate = next) }
+        refresh()
+    }
+
+    private fun adjustAnchorDate(amount: Int) {
+        if (amount == 0) return
+        val next = runCatching {
+            val current = LocalDate.parse(_uiState.value.anchorDate)
+            when (_uiState.value.selectedTab) {
+                HamaliHomeTab.MONTH -> current.plusMonths(amount.toLong()).toString()
+                else -> current.plusDays(amount.toLong()).toString()
+            }
+        }.getOrNull() ?: return
+        _uiState.update { it.copy(anchorDate = next) }
+        refresh()
+    }
+
+    private suspend fun loadDaily(workDate: String) {
+        repository.getMyDaily(workDate).fold(
+            onSuccess = { daily ->
+                _uiState.update {
+                    it.copy(isLoading = false, isRefreshing = false, daily = daily, errorMessage = null)
+                }
+            },
+            onFailure = { error ->
+                _uiState.update {
+                    it.copy(isLoading = false, isRefreshing = false, errorMessage = error.message)
+                }
+            },
+        )
+    }
+
+    private suspend fun loadSummary(period: String, anchorDate: String, isWeek: Boolean) {
+        repository.getMySummary(period, anchorDate).fold(
+            onSuccess = { summary ->
+                _uiState.update {
+                    if (isWeek) {
+                        it.copy(isLoading = false, isRefreshing = false, weekSummary = summary, errorMessage = null)
+                    } else {
+                        it.copy(isLoading = false, isRefreshing = false, monthSummary = summary, errorMessage = null)
+                    }
+                }
+            },
+            onFailure = { error ->
+                _uiState.update {
+                    it.copy(isLoading = false, isRefreshing = false, errorMessage = error.message)
+                }
+            },
+        )
+    }
+}
