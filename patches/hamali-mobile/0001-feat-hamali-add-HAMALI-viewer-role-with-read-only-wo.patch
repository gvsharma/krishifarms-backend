+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun HamaliHomeScreen(
+    onBack: () -> Unit,
+    showBack: Boolean = true,
+    viewModel: HamaliHomeViewModel = hiltViewModel(),
+) {
+    val uiState by viewModel.uiState.collectAsStateWithLifecycle()
+    val currencyFormat = NumberFormat.getCurrencyInstance(Locale("en", "IN"))
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text(stringResource(R.string.hamali_title)) },
+                navigationIcon = {
+                    if (showBack) {
+                        IconButton(onClick = onBack) {
+                            Icon(
+                                Icons.AutoMirrored.Filled.ArrowBack,
+                                contentDescription = stringResource(R.string.common_back),
+                            )
+                        }
+                    }
+                },
+            )
+        },
+    ) { padding ->
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(padding),
+        ) {
+            TabRow(selectedTabIndex = uiState.selectedTab.ordinal) {
+                Tab(
+                    selected = uiState.selectedTab == HamaliHomeTab.DAILY,
+                    onClick = { viewModel.onTabSelected(HamaliHomeTab.DAILY) },
+                    text = { Text(stringResource(R.string.hamali_tab_daily)) },
+                )
+                Tab(
+                    selected = uiState.selectedTab == HamaliHomeTab.WEEK,
+                    onClick = { viewModel.onTabSelected(HamaliHomeTab.WEEK) },
+                    text = { Text(stringResource(R.string.hamali_tab_week)) },
+                )
+                Tab(
+                    selected = uiState.selectedTab == HamaliHomeTab.MONTH,
+                    onClick = { viewModel.onTabSelected(HamaliHomeTab.MONTH) },
+                    text = { Text(stringResource(R.string.hamali_tab_month)) },
+                )
+            }
+
+            DateNavigator(
+                label = when (uiState.selectedTab) {
+                    HamaliHomeTab.DAILY -> viewModel.formatWorkDateLabel()
+                    HamaliHomeTab.WEEK, HamaliHomeTab.MONTH -> viewModel.periodLabel()
+                },
+                onPrevious = {
+                    when (uiState.selectedTab) {
+                        HamaliHomeTab.DAILY -> viewModel.onPreviousDay()
+                        else -> viewModel.onPreviousPeriod()
+                    }
+                },
+                onNext = {
+                    when (uiState.selectedTab) {
+                        HamaliHomeTab.DAILY -> viewModel.onNextDay()
+                        else -> viewModel.onNextPeriod()
+                    }
+                },
+            )
+
+            PullToRefreshBox(
+                isRefreshing = uiState.isRefreshing,
+                onRefresh = viewModel::refresh,
+                modifier = Modifier.fillMaxSize(),
+            ) {
+                when {
+                    uiState.isLoading -> {
+                        Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+                            CircularProgressIndicator()
+                        }
+                    }
+                    uiState.errorMessage != null -> {
+                        Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+                            Text(
+                                text = uiState.errorMessage ?: stringResource(R.string.common_error),
+                                color = MaterialTheme.colorScheme.error,
+                            )
+                        }
+                    }
+                    else -> {
+                        when (uiState.selectedTab) {
+                            HamaliHomeTab.DAILY -> DailyContent(
+                                daily = uiState.daily,
+                                currencyFormat = currencyFormat,
+                            )
+                            HamaliHomeTab.WEEK -> PeriodContent(
+                                summary = uiState.weekSummary,
+                                currencyFormat = currencyFormat,
+                            )
+                            HamaliHomeTab.MONTH -> PeriodContent(
+                                summary = uiState.monthSummary,
+                                currencyFormat = currencyFormat,
+                            )
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
