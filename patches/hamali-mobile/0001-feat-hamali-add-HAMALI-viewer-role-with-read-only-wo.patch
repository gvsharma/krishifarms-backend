+package com.krishifarms.mobile.feature.hamali.data.repository
+
+import com.krishifarms.mobile.core.common.DispatcherProvider
+import com.krishifarms.mobile.core.network.NetworkResult
+import com.krishifarms.mobile.core.network.safeApiCall
+import com.krishifarms.mobile.feature.hamali.data.remote.HamaliApi
+import com.krishifarms.mobile.feature.hamali.data.remote.dto.HamaliDailyDto
+import com.krishifarms.mobile.feature.hamali.data.remote.dto.HamaliDailyLineDto
+import com.krishifarms.mobile.feature.hamali.data.remote.dto.HamaliSummaryPeriodDto
+import com.krishifarms.mobile.feature.hamali.data.remote.dto.HamaliTipByFarmerDto
+import com.krishifarms.mobile.feature.hamali.data.remote.dto.HamaliWorkEntryDto
+import com.krishifarms.mobile.feature.hamali.domain.model.HamaliDailyLine
+import com.krishifarms.mobile.feature.hamali.domain.model.HamaliDailySummary
+import com.krishifarms.mobile.feature.hamali.domain.model.HamaliFarmerSummary
+import com.krishifarms.mobile.feature.hamali.domain.model.HamaliPeriodSummary
+import com.krishifarms.mobile.feature.hamali.domain.model.HamaliWorkEntry
+import com.krishifarms.mobile.feature.hamali.domain.repository.HamaliRepository
+import kotlinx.coroutines.withContext
+import javax.inject.Inject
+import javax.inject.Singleton
+
+@Singleton
+class HamaliRepositoryImpl @Inject constructor(
+    private val api: HamaliApi,
+    private val dispatchers: DispatcherProvider,
+) : HamaliRepository {
+
+    override suspend fun getMyDaily(workDate: String?): Result<HamaliDailySummary> =
+        withContext(dispatchers.io) {
+            when (val result = safeApiCall { api.getMyDaily(workDate) }) {
+                is NetworkResult.Success -> Result.success(result.data.data.toDomain())
+                is NetworkResult.Error -> Result.failure(IllegalStateException(result.message))
+            }
+        }
+
+    override suspend fun getMySummary(period: String, anchorDate: String?): Result<HamaliPeriodSummary> =
+        withContext(dispatchers.io) {
+            when (val result = safeApiCall { api.getMySummary(period, anchorDate) }) {
+                is NetworkResult.Success -> Result.success(result.data.data.toDomain())
+                is NetworkResult.Error -> Result.failure(IllegalStateException(result.message))
+            }
+        }
+
+    override suspend fun listWorkEntries(
+        workDate: String?,
+        dateFrom: String?,
+        dateTo: String?,
+    ): Result<List<HamaliWorkEntry>> = withContext(dispatchers.io) {
+        when (
+            val result = safeApiCall {
+                api.listWorkEntries(
+                    page = 1,
+                    pageSize = 100,
+                    workDate = workDate,
+                    dateFrom = dateFrom,
+                    dateTo = dateTo,
+                )
+            }
+        ) {
+            is NetworkResult.Success ->
+                Result.success(result.data.data.items.map { it.toDomain() })
+            is NetworkResult.Error ->
+                Result.failure(IllegalStateException(result.message))
+        }
+    }
+}
+
+private fun HamaliDailyDto.toDomain() = HamaliDailySummary(
+    workDate = workDate,
+    totalBags = totalBags,
+    totalTips = totalTips,
+    lines = lines.map { it.toDomain() },
+)
+
+private fun HamaliDailyLineDto.toDomain() = HamaliDailyLine(
+    farmerId = farmerId,
+    farmerName = farmerName,
+    bagCount = bagCount,
+    tipAmount = tipAmount,
+)
+
+private fun HamaliSummaryPeriodDto.toDomain() = HamaliPeriodSummary(
+    period = period,
+    dateFrom = dateFrom,
+    dateTo = dateTo,
+    totalBags = totalBags,
+    totalTips = totalTips,
+    daysWorked = daysWorked,
