diff --git a/modules/ci-backend-deploy-iam/main.tf b/modules/ci-backend-deploy-iam/main.tf
index a44e015..ca6488c 100644
--- a/modules/ci-backend-deploy-iam/main.tf
+++ b/modules/ci-backend-deploy-iam/main.tf
@@ -1,5 +1,11 @@
 data "aws_region" "current" {}
 
+data "aws_caller_identity" "current" {}
+
+locals {
+  ssm_parameter_arn_prefix = "arn:aws:ssm:${data.aws_region.current.name}:${data.aws_caller_identity.current.account_id}:parameter${var.ssm_parameter_prefix}"
+}
+
 locals {
   github_oidc_url = "https://token.actions.githubusercontent.com"
   repo_subject    = "repo:${var.github_repository}:*"
@@ -142,6 +148,48 @@ data "aws_iam_policy_document" "deploy" {
     ]
     resources = [var.ec2_instance_arn]
   }
+
+  dynamic "statement" {
+    for_each = var.ssm_parameter_prefix != "" ? [1] : []
+    content {
+      sid    = "ManageDeploySsmParameters"
+      effect = "Allow"
+      actions = [
+        "ssm:GetParameter",
+        "ssm:PutParameter",
+        "ssm:AddTagsToResource",
+      ]
+      resources = ["${local.ssm_parameter_arn_prefix}/*"]
+    }
+  }
+
+  dynamic "statement" {
+    for_each = var.cost_scheduler_lambda_name != "" ? [1] : []
+    content {
+      sid    = "ConfigureCostSchedulerLambda"
+      effect = "Allow"
+      actions = [
+        "lambda:GetFunctionConfiguration",
+        "lambda:UpdateFunctionConfiguration",
+      ]
+      resources = [
+        "arn:aws:lambda:${data.aws_region.current.name}:${data.aws_caller_identity.current.account_id}:function:${var.cost_scheduler_lambda_name}",
+      ]
+    }
+  }
+
+  dynamic "statement" {
+    for_each = var.enable_scheduler_schedule_management ? [1] : []
+    content {
+      sid    = "ManageOrphanEventBridgeSchedules"
+      effect = "Allow"
+      actions = [
+        "scheduler:GetSchedule",
+        "scheduler:DeleteSchedule",
+      ]
+      resources = ["arn:aws:scheduler:${data.aws_region.current.name}:${data.aws_caller_identity.current.account_id}:schedule/*"]
+    }
+  }
 }
 
 resource "aws_iam_role_policy" "deploy" {
