# Vercel / remote API template. For local dev, copy .env.local.example → .env.local
#
# Pair with backend on EC2 (see deploy/env/application.env.example).

# --- Vercel Production (also mirrored in vercel.json env defaults) ---
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Dynamic EC2 public IP — resolve live, never commit a real IP:
#   bash deploy/scripts/resolve-ec2-ip.sh
# See docs/deploy/DYNAMIC_IP.md (update Vercel dashboard env on every IP change).
API_PROXY_TARGET=http://<EC2_PUBLIC_IP>:8082
NEXT_PUBLIC_SITE_URL=https://krishifarms-backend.vercel.app

# Backend CORS_ORIGINS must include NEXT_PUBLIC_SITE_URL.

# Optional dev auth (local only — never commit real tokens)
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=owner@krishifarms.local
# NEXT_PUBLIC_DEV_LOGIN_PASSWORD=ChangeMe123!
# NEXT_PUBLIC_DEV_ACCESS_TOKEN=
