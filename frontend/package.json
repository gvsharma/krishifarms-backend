{
  "name": "krishifarms-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:unit": "node --experimental-strip-types --test src/features/auth/session-recovery.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --project=setup --project=smoke-chromium",
    "test:e2e:visual": "playwright test --project=setup --project=visual",
    "test:e2e:visual:update": "playwright test --project=setup --project=visual --update-snapshots",
    "test:e2e:responsive": "playwright test --project=setup --project=responsive --project=mobile-chrome",
    "test:e2e:a11y": "playwright test --project=setup --project=regression",
    "test:e2e:workflow": "playwright test --project=setup --project=workflow",
    "test:e2e:chromium": "playwright test --project=setup --project=chromium",
    "test:e2e:cross-browser": "playwright test --project=setup --project=chromium --project=firefox --project=webkit"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/material-nextjs": "^6.5.0",
    "@mui/x-charts": "^7.29.1",
    "@tanstack/react-query": "^5.62.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^15.5.21",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "js-yaml": "^4.3.0",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@5": "5.0.7",
    "next": {
      "postcss": "8.5.10"
    }
  }
